# ── required ─────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Turso database (turso db show <name> --url  /  turso db tokens create <name>)
# Leave empty locally to use a SQLite file (crevio.db)
TURSO_DATABASE_URL=libsql://crevio-yourname.turso.io
TURSO_AUTH_TOKEN=

# ── optional ─────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use /stats and /broadcast
ADMIN_IDS=
# Max addresses per user
MAX_INBOXES=5
# How often to check inboxes for new mail (seconds, min 5)
POLL_INTERVAL_SEC=8
# Mail providers: tm = mail.tm, gw = mail.gw, tio = temp-mail.io, gm = guerrillamail
MAIL_PROVIDERS=tm,gw,tio,gm
# Public https URL. On Render this is auto-detected from RENDER_EXTERNAL_URL.
# When set, the bot runs in webhook mode; when empty, it long-polls (local dev).
PUBLIC_URL=
# 1 = self-ping /health every 10 min so Render free tier doesn't sleep (default on Render)
KEEP_ALIVE=

# ── custom domains & sending ─────────────────────────────
# 0 = only admins can add custom domains
ALLOW_USER_DOMAINS=1
# Daily send cap per user on their OWN domain (0 = unlimited)
SEND_LIMIT_OWN=0
# Daily send cap per user on admin-shared (💎) domains (0 = unlimited)
SEND_LIMIT_SHARED=50
# Max inbound mail size for custom domains (MB)
INBOUND_MAX_MB=15
# Which shared domain relays mail for temp addresses (default: first shared sending domain)
SEND_RELAY_DOMAIN=
